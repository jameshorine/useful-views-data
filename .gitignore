# this is a repo level gitignore file.

# Ignore ArcGIS file geodatabase data in the crop-sequence-boundaries/in directory
crop-sequence-boundaries/in/CSB1825.gdb/

crop-sequence-boundaries/out/

# Ignore the views themselves, but commit each release's datapackage.json
# (its checksums and schemas) so rebuilds can be checked with git diff.
crop-sequence-boundaries/useful-views/**
!crop-sequence-boundaries/useful-views/**/
!crop-sequence-boundaries/useful-views/**/datapackage.json

# FAS PSD: source zips are monthly snapshots (~10 MB each), recorded in
# fas-psd/in/SOURCES.md by SHA256 rather than committed.
fas-psd/in/*.zip
fas-psd/out/
fas-psd/useful-views/**
!fas-psd/useful-views/**/
!fas-psd/useful-views/**/datapackage.json

# Each examples/<name>/ is a real useful-views project, and can be fully built
# locally with `useful-views sync`. Only its README.md, raw/ and recipes/ are
# published (useful-views downloads exactly those), so keep what init and sync
# make out of git.
examples/*/.gitignore
examples/*/datapackage.json
examples/*/work/
examples/*/useful-views/

# OS / Python artifacts
.DS_Store
__pycache__/
*.pyc
