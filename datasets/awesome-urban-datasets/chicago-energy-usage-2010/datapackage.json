  "recipes": [
    {
      "name": "energy_usage_2010",
      "description": "The City of Chicago's Energy Usage 2010, every column typed: one row per community area, census block, building type and subtype, plus one row per community area that the portal gives without a census block.",
      "path": "recipes/energy_usage_2010",
      "inputs": ["raw/energy_usage_2010.csv"],
      "outputs": ["useful-views/energy-usage-2010.parquet"],
      "steps": [
        {
          "name": "type_and_check",
          "path": "recipes/energy_usage_2010/01_type_and_check.py",
          "description": "Check that the CSV is the pinned download (its SHA-256) with the portal's 73 columns in order. Give every column a fixed type: census blocks as their 15-digit code, energy and counts as integers, statistics and averages as decimals. Split the two account counts into a number and a note (\"Less than 4\"), rename the portal's misspelled term_april_2010, sort by the key, and check the table's known facts."
        }
      ]
    },
    {
      "name": "community_areas",
      "description": "Electricity (kWh) and gas (therms) used in 2010 in each of Chicago's 77 community areas, summed over the census-block rows of Energy Usage 2010.",
      "path": "recipes/community_areas",
      "inputs": ["useful-views/energy-usage-2010.parquet"],
      "outputs": ["useful-views/energy-usage-2010-community-areas.parquet"],
      "steps": [
        {
          "name": "sum_block_rows",
          "path": "recipes/community_areas/01_sum_block_rows.py",
          "description": "Sum annual kWh and therms over each community area's census-block rows, leaving out the portal's rows without a census block (see the README), count the blocks and rows behind each sum, and check that nothing is lost."
        }
      ]
    },
    {
      "name": "monthly",
      "description": "Monthly electricity (kWh) and gas (therms) for every row of Energy Usage 2010, in long form: one row per community area, census block, building type, subtype and month of 2010.",
      "path": "recipes/monthly",
      "inputs": ["useful-views/energy-usage-2010.parquet"],
      "outputs": ["useful-views/energy-usage-2010-monthly.parquet"],
      "steps": [
        {
          "name": "to_long",
          "path": "recipes/monthly/01_to_long.py",
          "description": "Turn the twelve kWh and twelve therm columns into one row per month, keeping the key, and check that every row's months add up to its published annual totals."
        }
      ]
    }
  ]
